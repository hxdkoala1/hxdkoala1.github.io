{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Reading Novels (Web Server)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "args": [
        "--web-hostname=127.0.0.1",
        "--web-port=7357",
        "--dart-define=GOOGLE_OAUTH_CLIENT_ID=${env:GOOGLE_OAUTH_CLIENT_ID}"
      ]
    }
  ]
}
